generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDIENTE
  EN_PROCESO
  ENVIADO
  ENTREGADO
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  ownerId   String   @default("demo") // cada cuenta ve solo sus propios datos
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([ownerId, email])
}

model Product {
  id    String      @id @default(cuid())
  name  String
  price Decimal     @db.Decimal(12, 2)
  cost  Decimal     @db.Decimal(12, 2)
  ownerId String    @default("demo")
  items OrderItem[]

  @@unique([ownerId, name])
}

model Order {
  id         String      @id // folio legible: OM-1048
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDIENTE)
  ownerId    String      @default("demo")
  date       DateTime    @db.Date
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@index([status])
  @@index([date])
  @@index([ownerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2) // precio al momento de la compra
  cost      Decimal @db.Decimal(12, 2)
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String   // sin FK: el historial sobrevive al borrado del pedido
  action    String   // CREATE | UPDATE | STATUS | DELETE
  detail    String
  actor     String   @default("demo")
  ownerId   String   @default("demo")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ownerId])
}

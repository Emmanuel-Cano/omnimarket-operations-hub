# --- Base de datos (Neon / Supabase / Railway) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Autenticación OAuth 2.0 (Auth.js) ---
# Genera el secreto con:  npx auth secret   (o: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Necesario detrás de un proxy/hosting (Railway, Render). Vercel lo detecta solo.
AUTH_TRUST_HOST="true"

# --- Opcional: asistente con Claude (sin clave responde con análisis local) ---
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- SOLO para pruebas E2E. NUNCA lo definas en producción ---
# E2E_TEST_MODE="true"
